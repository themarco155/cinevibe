# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a GitHub (está en .gitignore).

# Clave de la API de TMDB (https://www.themoviedb.org/settings/api).
# Sirve tanto la "API Key" corta como el "Token de acceso de lectura" largo.
TMDB_API_KEY=

# Opcional: URL base de la API. Solo se cambia para pruebas locales.
# TMDB_BASE_URL=https://api.themoviedb.org/3
